SPRING_PROFILES_ACTIVE=local

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:9b
TAVILY_API_KEY=

APP_DEBUG_ENABLED=true
APP_LLM_FALLBACK_POLICY=BLOCK_OPENAI
APP_MEMORY_STORE=in-memory
APP_MEMORY_REDIS_TTL_HOURS=24
APP_SEARCH_PROVIDER=dummy

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/nalbbun_vector
SPRING_DATASOURCE_USERNAME=nalbbun
SPRING_DATASOURCE_PASSWORD=nalbbun1234
# API CRUD DB (optional; if omitted, spring.datasource is reused)
APP_API_DATASOURCE_URL=
APP_API_DATASOURCE_USERNAME=
APP_API_DATASOURCE_PASSWORD=
APP_API_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_DATABASE=0

POSTGRES_DB=postgres
POSTGRES_USER=nalbbun
POSTGRES_PASSWORD=nalbbun1234
POSTGRES_PORT=5432
REDIS_PORT=6379

APP_RAG_ENABLED=false
APP_RAG_VECTOR_STORE=pgvector
APP_RAG_TOP_K=4
APP_RAG_SIMILARITY_THRESHOLD=0.72
APP_RAG_GENERAL_ENABLED=false
APP_RAG_DEV_ENABLED=true
APP_RAG_MICE_ENABLED=true
APP_RAG_TRAVEL_ENABLED=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
SPRING_AI_VECTORSTORE_PGVECTOR_INITIALIZE_SCHEMA=true
SPRING_AI_VECTORSTORE_PGVECTOR_DIMENSIONS=768

# Example split DB policy
# - spring.datasource: RAG/vector DB
# - app.api.datasource: API CRUD/Flyway DB
APP_VECTOR_DB_NAME=nalbbun_vector
APP_API_DB_NAME=nalbbun_api

# Vector DB (RAG / pgvector)
APP_VECTOR_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nalbbun_vector
APP_VECTOR_DATASOURCE_USERNAME=nalbbun
APP_VECTOR_DATASOURCE_PASSWORD=nalbbun1234

# API CRUD DB (api_key/prompt/runtime_state)
APP_API_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nalbbun_api
APP_API_DATASOURCE_USERNAME=nalbbun
APP_API_DATASOURCE_PASSWORD=nalbbun1234

# Memory JDBC DB (optional, fallback: API DB)
APP_MEMORY_JDBC_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nalbbun_memory
APP_MEMORY_JDBC_DATASOURCE_USERNAME=nalbbun
APP_MEMORY_JDBC_DATASOURCE_PASSWORD=nalbbun1234
